# RepairHub production settings. Copy to deploy/.env (git-ignored) and fill in REAL values.
# Never commit deploy/.env. Keep a copy of it in a safe place (password manager): it holds the database password.

# Where the site is reached; no "https://" prefix.
#   Public domain (Let's Encrypt, needs DNS + ports 80/443 open):  repair.example.kz
#   Local network only (Caddy's local CA, see README):              192.168.1.10
RH_SITE_ADDRESS=repair.example.kz

# How the HTTPS certificate is obtained:
#   public domain:      the e-mail for the Let's Encrypt account (expiry notices), e.g. admin@example.kz
#   local network only: internal
RH_TLS=admin@example.kz

# Published ports. Keep 80/443: Let's Encrypt and the HTTP→HTTPS redirect expect them.
HTTP_PORT=80
HTTPS_PORT=443

# Image tag for this deployment, e.g. the git tag or commit you deploy. Previous tags stay on the server,
# which makes a rollback a matter of switching this value back (see README, "Rollback").
RH_VERSION=latest

# PostgreSQL. Generate a long random password, e.g.
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 32
POSTGRES_DB=repairhub
POSTGRES_USER=repairhub
POSTGRES_PASSWORD=

# JWT signing key: at least 32 random characters (openssl rand -base64 48).
# Changing it signs everybody out once.
JWT_SIGNING_KEY=

# Automatic database backups (service "backup"; see README, "Backups").
# Daily backup time(s) in BACKUP_TZ, 24-hour HH:MM, comma-separated for more than one: 03:00 or 03:00,13:30
BACKUP_SCHEDULE=03:00
BACKUP_TZ=Asia/Almaty
# Delete backups older than this many days...
BACKUP_KEEP_DAYS=7
# ...but always keep at least this many of the newest ones, whatever their age.
BACKUP_KEEP_MIN=3
# The backup container reports "unhealthy" if the newest backup is older than this.
BACKUP_MAX_AGE_HOURS=26
# Host directory for the backup files (outside the database volume). Relative paths are relative to deploy/.
# On a Linux server prefer an absolute path, e.g. /var/backups/repairhub. Files are readable by root only.
BACKUP_DIR=./backups
