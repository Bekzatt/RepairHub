# RepairHub production reverse proxy (Caddy 2).
#
#   browser ──HTTPS──► Caddy ──┬── /api/*, /health/*  ──► api:8080 (plain HTTP inside the Docker network)
#                              └── everything else    ──► the built SPA in /srv (index.html fallback)
#
# RH_SITE_ADDRESS and RH_TLS (deploy/.env) decide how the certificate is obtained:
#   - public domain (RH_SITE_ADDRESS=repair.example.kz, RH_TLS=admin@example.kz): automatic Let's Encrypt
#     certificate; needs DNS → this server and ports 80 and 443 reachable from the internet;
#   - LAN IP or internal name (RH_SITE_ADDRESS=192.168.1.10, RH_TLS=internal): certificate from Caddy's own
#     local CA; each device must trust that CA's root certificate once (README, "HTTPS in a local network").

{
	# The local CA root is distributed manually; never try to install it into the container's trust store.
	skip_install_trust
	# Browsers send no SNI when the site is opened by IP address; use the site certificate anyway.
	default_sni {$RH_SITE_ADDRESS}
}

{$RH_SITE_ADDRESS} {
	# "internal" or the e-mail address for the Let's Encrypt account.
	tls {$RH_TLS}

	encode zstd gzip

	# The API. Caddy sets X-Forwarded-For/-Proto/-Host itself and replaces any such headers sent by the
	# client (it trusts no upstream proxies), so the API can trust exactly this one hop.
	@api path /api/* /health/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Hashed file names: cache for a year. index.html: always revalidate, so a deployment is picked up.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"

		# Client-side routes (/orders/123) are served by index.html.
		try_files {path} /index.html
		file_server
	}

	# Deferred (">") so they also replace whatever the API sent.
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options "nosniff"
		>X-Frame-Options "DENY"
		>Referrer-Policy "same-origin"
		>Permissions-Policy "camera=(), microphone=(), geolocation=()"
		>Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Container health check only; this port is not published.
http://:8081 {
	respond /healthz "ok" 200
}
