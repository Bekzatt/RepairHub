{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Auth": {
    "RefreshCookie": {
      "Secure": false
    }
  }
}
