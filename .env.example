# Copy to .env and set real values. .env is git-ignored — never commit it.

# PostgreSQL
POSTGRES_DB=repairhub
POSTGRES_USER=repairhub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS_ON_STARTUP=true

# JWT signing key: at least 32 random characters. Generate one with e.g.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-value
